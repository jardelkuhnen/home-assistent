# ---------------------------------------------------------------------------
# home-assistent-brain — modelo de variáveis de ambiente
# Copie para .env e preencha. NUNCA commite .env com valores reais.
# ---------------------------------------------------------------------------

# --- Motor cognitivo (ADR-0001) ---
# Provedor do LLM: "gemini" ou "openai".
LLM_PROVIDER=gemini

# Gemini (langchain-google-genai).
GEMINI_API_KEY=

# OpenAI-compatível (langchain-openai). Usado quando LLM_PROVIDER=openai.
# Opcional: deixe OPENAI_API_BASE vazio para o endpoint oficial da OpenAI.
OPENAI_API_KEY=
OPENAI_API_BASE=

# Timeout (segundos) para chamadas ao motor cognitivo.
LLM_TIMEOUT_S=30.0

# --- Home Assistant / Alexa Media Player ---
# URL base da instância do Home Assistant (ex: http://homeassistant.local:8123).
HA_URL=http://localhost:8123
# Token de longa duração do Home Assistant com PERMISSÃO MÍNIMA:
# apenas `services: call_service` para `notify.alexa_media`, `homeassistant`
# e os domínios `switch`/`light` relevantes. NUNCA use um token admin.
HA_TOKEN=
HA_TIMEOUT_S=5.0
# Entity ID do media_player do Alexa que fará a síntese de voz.
ALEXA_MEDIA_ENTITY=media_player.alexa_sala

# --- Tavily (busca web) ---
TAVILY_API_KEY=

# --- API do Cérebro (auth X-API-Key) ---
# Chave exigida no header `X-API-Key` do POST /chat (baseline item 4).
BRAIN_API_KEY=

# --- Satélite → Cérebro ---
# URL onde o Cérebro (api.py) está escutando.
BRAIN_URL=http://localhost:8000

# --- STT (faster-whisper) ---
# Tamanho do modelo Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
